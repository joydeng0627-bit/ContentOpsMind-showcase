# Configure an Anthropic Messages-compatible endpoint and supported model.
# Never commit .env. OpenAI-compatible-only endpoints are not interchangeable.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
REDIS_PASSWORD=
LOG_LEVEL=INFO
KNOWLEDGE_WARMUP=true
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=

# Governed retrieval: weighted is the rollback strategy.
RAG_FUSION_STRATEGY=rrf
RAG_BRANCH_TOP_K=20
RAG_RRF_K=60
RAG_RERANK_CANDIDATES=20
