{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["decision", "risk_items", "missing_evidence", "summary"],
  "properties": {
    "decision": { "enum": ["pass", "changes_required", "blocked"] },
    "risk_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "severity",
          "matched_text",
          "evidence_refs",
          "reason",
          "suggestion"
        ],
        "properties": {
          "rule_id": { "type": "string" },
          "severity": { "enum": ["low", "medium", "high"] },
          "matched_text": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" },
          "suggestion": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" }
  },
  "additionalProperties": false
}
